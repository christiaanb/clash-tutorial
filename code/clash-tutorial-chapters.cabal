cabal-version:       2.4
name:                clash-tutorial-chapters
version:             0.1.0.0
license:             BSD-2-Clause
author:              Christiaan Baaij
maintainer:          christiaan@qbaylogic.com
synopsis:            Every chapter's end state, built in CI

-- Kept deliberately close to template/clash-tutorial.hsfiles. The reader's
-- project is configured by that template; if this package's options drift from
-- it, code that builds here can fail on the reader's machine.
common common-options
  default-extensions:
    BangPatterns
    BinaryLiterals
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DeriveDataTypeable
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveTraversable
    DerivingStrategies
    InstanceSigs
    KindSignatures
    LambdaCase
    NumericUnderscores
    PolyKinds
    QuasiQuotes
    RankNTypes
    ScopedTypeVariables
    StandaloneDeriving
    TemplateHaskell
    TemplateHaskellQuotes
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    MagicHash
    NoImplicitPrelude
    NoMonomorphismRestriction
    NoStarIsType
    NoStrictData

  ghc-options:
    -Wall -Wcompat
    -haddock
    -fplugin GHC.TypeLits.Extra.Solver
    -fplugin GHC.TypeLits.Normalise
    -fplugin GHC.TypeLits.KnownNat.Solver
    -fexpose-all-unfoldings
    -fno-worker-wrapper

  build-depends:
    base,
    clash-prelude,
    ghc-typelits-natnormalise,
    ghc-typelits-extra,
    ghc-typelits-knownnat,

  default-language: Haskell2010

library
  import:          common-options
  hs-source-dirs:  src
  exposed-modules: Chapters.Ch01
                   Chapters.Ch02
                   Chapters.Ch03

executable clash
  main-is:          bin/Clash.hs
  default-language: Haskell2010
  build-depends:    base, clash-ghc, clash-tutorial-chapters
  if !os(windows)
    ghc-options:  -dynamic

executable clashi
  main-is:          bin/Clashi.hs
  default-language: Haskell2010
  build-depends:    base, clash-ghc, clash-tutorial-chapters
  if !os(windows)
    ghc-options:  -dynamic

test-suite doctests
  import:         common-options
  type:           exitcode-stdio-1.0
  hs-source-dirs: tests
  main-is:        doctests.hs
  build-depends:  base, clash-tutorial-chapters, doctest-parallel
