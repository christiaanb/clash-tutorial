{-# START_FILE {{name}}.cabal #-}
cabal-version:       2.4
name:                {{name}}
version:             0.1.0.0
license:             BSD-2-Clause
author:              {{author-name}}{{^author-name}}Author name here{{/author-name}}
maintainer:          {{author-email}}{{^author-email}}example@example.com{{/author-email}}

common common-options
  default-extensions:
    BangPatterns
    BinaryLiterals
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DeriveDataTypeable
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveTraversable
    DerivingStrategies
    InstanceSigs
    KindSignatures
    LambdaCase
    NumericUnderscores
    PolyKinds
    QuasiQuotes
    RankNTypes
    ScopedTypeVariables
    StandaloneDeriving
    TemplateHaskell
    TemplateHaskellQuotes
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    -- Clash specific. See the Clash documentation for why each of these is
    -- required rather than merely convenient.
    MagicHash
    NoImplicitPrelude
    NoMonomorphismRestriction
    NoStarIsType
    NoStrictData

  ghc-options:
    -Wall -Wcompat
    -haddock
    -- Type level natural number solvers. Without these, arithmetic on vector
    -- lengths does not typecheck.
    -fplugin GHC.TypeLits.Extra.Solver
    -fplugin GHC.TypeLits.Normalise
    -fplugin GHC.TypeLits.KnownNat.Solver
    -- Clash needs to see through to the definitions it compiles.
    -fexpose-all-unfoldings
    -fno-worker-wrapper

  build-depends:
    base,
    clash-prelude,
    ghc-typelits-natnormalise,
    ghc-typelits-extra,
    ghc-typelits-knownnat,

  default-language: Haskell2010

library
  import:          common-options
  hs-source-dirs:  src
  exposed-modules: Example.Project

-- Run with: stack run clash -- Example.Project --vhdl
--
-- Not built against common-options: it needs the ordinary Prelude for IO,
-- and NoImplicitPrelude there leaves `IO` out of scope.
executable clash
  main-is:          bin/Clash.hs
  default-language: Haskell2010
  build-depends:    base, clash-ghc, {{name}}
  if !os(windows)
    ghc-options:  -dynamic

-- Run with: stack run clashi
executable clashi
  main-is:          bin/Clashi.hs
  default-language: Haskell2010
  build-depends:    base, clash-ghc, {{name}}
  if !os(windows)
    ghc-options:  -dynamic

test-suite doctests
  import:         common-options
  type:           exitcode-stdio-1.0
  hs-source-dirs: tests
  main-is:        doctests.hs
  build-depends:  base, {{name}}, doctest-parallel

{-# START_FILE stack.yaml #-}
# Pinned deliberately. The tutorial's transcripts are captured against exactly
# this resolver, and changing it invalidates them.
resolver: lts-24.38

packages:
  - .

# Copied 2026-08-05 from clash-lang/clash-starters/simple/stack.yaml (main
# branch), the configuration Clash upstream keeps building against lts-24.38.
extra-deps:
- clash-ghc-1.10.0@sha256:d196fd5454e119fa86a2d28736081abb1f176317e80f70972ad6ae96b957af3a,9152
- clash-lib-1.10.0@sha256:3d512d1d8270586415e35d1eff3a47233978cf106d7909f064f100702a22c167,15776
- clash-prelude-1.10.0@sha256:69daccb6c9066bac22846e59fc34a3335181c7b3d946715d2cb3204e42391d92,18110
- clash-prelude-hedgehog-1.10.0@sha256:8d9738c12ce9742647dff05e807e069cc9cbc8c8831da5ea3899ee71932bc378,1615
- ghc-typelits-extra-0.5.3@sha256:4fae3c698c15132181a431e52f95aa8f655dc78bcd2a5fdf35a7e222eb7d2d19,5830
- ghc-typelits-knownnat-0.8.3@sha256:84114e2d8a4389c37921ed1b3dd030c6acd8af0eb47d5cb516e3a374ade0f9b4,5993
- ghc-typelits-natnormalise-0.9.5@sha256:692d7a936ecee9e3a994f0a60d136be1f03137d38aca90f03b8efcb40bed90ca,3973
- ghc-tcplugin-api-0.18.2.1@sha256:a5e1e7019f94203508a9a398cf1210ec813d2e11a880d325b0259985dbf7b02a,5426

{-# START_FILE src/Example/Project.hs #-}
module Example.Project where

import Clash.Explicit.Prelude

plus :: Signed 8 -> Signed 8 -> Signed 8
plus a b = a + b

topEntity :: Signed 8 -> Signed 8 -> Signed 8
topEntity = plus

{-# START_FILE bin/Clash.hs #-}
import Prelude
import System.Environment (getArgs)
import Clash.Main (defaultMain)

main :: IO ()
main = getArgs >>= defaultMain

{-# START_FILE bin/Clashi.hs #-}
import Prelude
import System.Environment (getArgs)
import Clash.Main (defaultMain)

main :: IO ()
main = getArgs >>= defaultMain . ("--interactive":)

{-# START_FILE tests/doctests.hs #-}
-- `import Prelude` is needed because common-options turns on NoImplicitPrelude,
-- which leaves `IO` out of scope here.
import Prelude
import Test.DocTest (mainFromCabal)
import System.Environment (getArgs)

main :: IO ()
main = mainFromCabal "{{name}}" =<< getArgs

{-# START_FILE .gitignore #-}
dist-newstyle/
.stack-work/
vhdl/
verilog/
systemverilog/
*.fst
*.vcd
work/

{-# START_FILE README.md #-}
# {{name}}

Created from the `clash-tutorial` project template.

Open the interpreter:

    stack run clashi

Generate VHDL:

    stack run clash -- Example.Project --vhdl
